# VEERA Frontend Configuration
# Copy this file to .env and adjust values as needed.

# Base URL for the VEERA Python/FastAPI backend.
# Leave empty or omit when using mock mode.
# Example: http://localhost:8000
VITE_API_BASE_URL=

# Set to "true" to enable mock mode (no backend required).
# Set to "false" to use the real FastAPI backend (VITE_API_BASE_URL must be set).
VITE_MOCK_MODE=true
